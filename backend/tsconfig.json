{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2020",
     
    "typeRoots": ["./node_modules/@types", "./src/types"],
    

    "types": ["node"],
    "sourceMap": true,

    "strict": true,
    "isolatedModules": true,

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "moduleDetection": "force",
    "skipLibCheck": true
  },
    "include" : ["src"]
}
